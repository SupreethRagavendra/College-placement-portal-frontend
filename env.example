# Application
APP_NAME="College Placement Portal"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your-generated-key
APP_URL=https://your-app.vercel.app

# Database (Supabase - Shared)
DB_CONNECTION=pgsql
DB_HOST=db.wkqbukidxmzbgwauncrl.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.wkqbukidxmzbgwauncrl
DB_PASSWORD=your-secure-password
DB_SSLMODE=require

# Cache & Session
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# RAG Service Connection
RAG_SERVICE_URL=https://rag-service.onrender.com
RAG_ENABLED=true
RAG_SERVICE_TIMEOUT=30

# OpenRouter API (for direct calls if needed)
OPENROUTER_API_KEY=your-openrouter-api-key

# Security
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app
TRUSTED_PROXIES=*
